# Server-only. Paste real values privately into .env.local / Vercel settings.
# Runtime: Neon connection string with "-pooler" in the host and sslmode=require.
DATABASE_URL=
# Optional tooling connection: same Neon branch/database, pooling disabled.
DATABASE_URL_UNPOOLED=
# Keep the existing valid hash; do not rotate merely to change database providers.
ADMIN_PASSWORD_HASH=
# ADMIN_DATABASE_PATH is no longer used by the app. SQLite remains a migration source only.
